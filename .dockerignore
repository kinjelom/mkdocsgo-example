# Keep the build context to what `mkdocs build` actually needs: mkdocs.yml,
# docs/, requirements.txt - and deploy/, because documentation pages include
# the real manifests with `--8<--` rather than restating them.
#
# Note that a root-level pattern like *.md does not match docs/**.md: Docker
# matches the whole path and * does not cross a /.
.git
.github
.venv
.mkdocsgo
site
dist
scripts
*.md
.env
.gitignore
.dockerignore
